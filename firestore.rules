rules_version = '2';

// KidsMarket — Firestore Security Rules (production)
//
// Single collection: `clothes` (the product catalog).
// Wishlists/favourites are stored in browser localStorage, not Firestore,
// so no other collections need rules.
//
// Admin write allowlist mirrors ADMIN_EMAILS in shared/js/auth-guard.js.
// NOTE: request.auth.token.email is only trustworthy for verified providers
// (Google sign-in). If email/password accounts are ever added, switch the
// write check to a UID allowlist instead.

service cloud.firestore {
  match /databases/{database}/documents {

    // Product catalog — anyone can read; only admins can write.
    match /clothes/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'faresayman12316@gmail.com',
          'kids.market66@gmail.com'
        ];
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
